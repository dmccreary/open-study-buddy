# Run this on your COMPUTER, not on the Pico.
#
#   pip install pillow
#   python3 tools/mascot-to-rgb565.py
#
# Shrinks the @@MASCOT_NAME@@ artwork (@@SOURCE_NAME@@) to fit SIZE x SIZE and
# lays it on the demo's @@BG_NAME@@ background, so any transparent corners
# match the screen. Writes raw RGB565 pixels, high byte first, with no
# header. 140 x 140 x 2 = 39,200 bytes. If you change SIZE here, change
# MASCOT_SIZE in @@PROGRAM@@ too.
@@SVG_NOTE@@
from pathlib import Path
from PIL import Image

SIZE = 140

# Must match BACKGROUND in @@PROGRAM@@ (@@BG_NAME@@).
BACKGROUND = (@@BG_HEX_TUPLE@@)

here = Path(__file__).resolve().parent.parent
source = here / "../../../docs/schools/@@ID@@/@@SOURCE_PATH@@"
dest = here / "@@IMAGE_FILE@@"

art = Image.open(source).convert("RGBA")
art.thumbnail((SIZE, SIZE), Image.LANCZOS)
canvas = Image.new("RGBA", (SIZE, SIZE), BACKGROUND + (255,))
canvas.alpha_composite(art, ((SIZE - art.width) // 2, (SIZE - art.height) // 2))

rgb = canvas.convert("RGB").tobytes()
with open(dest, "wb") as out:
    for i in range(0, len(rgb), 3):
        r, g, b = rgb[i], rgb[i + 1], rgb[i + 2]
        out.write(((r & 0xF8) << 8 | (g & 0xFC) << 3 | b >> 3).to_bytes(2, "big"))
print("wrote", dest.name, dest.stat().st_size, "bytes")
